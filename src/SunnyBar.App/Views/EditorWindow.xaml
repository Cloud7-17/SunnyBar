<Window Icon="/SunnyBar.App;component/Assets/SunnyBar.ico" x:Class="SunnyBar.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunny Bar — 日程与标记" Width="1200" Height="880" MinWidth="1060" MinHeight="800"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#E7ECF2" BorderBrush="#CED6E0" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,24">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <TextBlock Text="Sunny Bar" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" SelectionChanged="OnNavigationChanged" AutomationProperties.Name="编辑功能导航">
                    <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.Resources>
                    <ListBoxItem Content="日程" Tag="schedule"/>
                    <ListBoxItem Content="每日标记" Tag="3"/>
                    <ListBoxItem IsEnabled="False" Focusable="False" Margin="0,30,0,4"><TextBlock Text="其他设置" FontSize="12" Foreground="#64748B"/></ListBoxItem>
                    <ListBoxItem Content="地点" Tag="0"/>
                    <ListBoxItem Content="时间轴与外观" Tag="1"/>
                    <ListBoxItem Content="当前时间指针" Tag="2"/>
                    <ListBoxItem Content="运行" Tag="4"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <ContentControl x:Name="ScheduleContent"/>
            <ContentControl x:Name="SettingsContent" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
