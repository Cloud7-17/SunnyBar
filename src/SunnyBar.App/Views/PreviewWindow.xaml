<Window Icon="/SunnyBar.App;component/Assets/SunnyBar.ico" x:Class="SunnyBar.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunnyBar.App.Controls"
        Title="Sunny Bar — 时间轴预览" Width="960" Height="400"
        MinWidth="620" MinHeight="360" WindowStartupLocation="CenterScreen"
        Background="#182230" Foreground="#E8EEF5" FontFamily="Segoe UI">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="设置…" Click="OnOpenSettings" Padding="12,5"/>
                <TextBlock Text="时间轴预览" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HoverTimeText}" Foreground="#FFCF70" FontSize="16" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </DockPanel>
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding DisplayDayText}" Foreground="#A0B1C4"/>
                <TextBlock Text="{Binding SelectedLocation.Name}" Foreground="#A0B1C4" Margin="16,0,0,0"/>
            </WrapPanel>
        </StackPanel>
        <controls:TimelineControl Grid.Row="1" Snapshot="{Binding Snapshot}" IndicatorImage="{Binding IndicatorImage}"
                                  Height="132" VerticalAlignment="Center" AutomationProperties.Name="04:00 至次日 04:00 时间轴"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding CurrentScheduleText}" Foreground="#FFCF70" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentScheduleText}"/>
            <TextBlock Text="{Binding NextScheduleText}" Foreground="#A0B1C4" TextTrimming="CharacterEllipsis" ToolTip="{Binding NextScheduleText}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,4,0,0">
            <TextBlock Text="{Binding PreviewSolarStatus}" Foreground="#A0B1C4"/>
            <TextBlock Text="{Binding IndicatorMessage}" Foreground="#FFCF70" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
