<Window x:Class="SunnyBar.App.Views.HoverInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunny Bar — 当前信息" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" MaxWidth="420"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border Background="#F5182230" BorderBrush="#52627A" BorderThickness="1" CornerRadius="8" Padding="14,10"
            IsHitTestVisible="False">
        <StackPanel>
            <TextBlock Text="{Binding HoverTimeText}" Foreground="#FFCF70" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding NextMarkerText}" Foreground="#E8EEF5" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="320" />
            <TextBlock Text="{Binding RemainingText}" Foreground="#C5D1DF" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
