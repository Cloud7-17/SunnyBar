<UserControl x:Class="SunnyBar.App.Views.SettingsEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SunnyBar.App.ViewModels"
         Background="#F3F5F8" Foreground="#182230" FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <ControlTemplate x:Key="SectionOnlyTemplate" TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,16,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="PageTitle" Text="Sunny Bar 设置" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="修改后点击“保存并应用”，立即更新悬浮条，并在下次启动时恢复。" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="1">
            <TabItem Header="地点">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="所有地点均按操作系统时区显示。请选择与电脑时区一致的地点，或手动输入坐标。" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="预设地点"/><ComboBox ItemsSource="{Binding Cities}" SelectedIndex="{Binding City}" AutomationProperties.Name="预设地点"/>
                    <StackPanel IsEnabled="{Binding HasLocation}">
                        <TextBlock Text="地点名称"/><TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="地点名称"/>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="纬度（-90～90）"/><TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="纬度"/></StackPanel>
                            <StackPanel><TextBlock Text="经度（-180～180）"/><TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="经度"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Text="选择“未选择地点”可继续使用中性色时间条。不会自动定位、联网或上传地点。" TextWrapping="Wrap" Foreground="#52627A"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="时间轴与外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="默认全宽贴边、不显示刻度；以下参数可按需调整。" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2">
                        <StackPanel><TextBlock Text="宽度百分比（20～100）"/><TextBox Text="{Binding WidthPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="宽度百分比"/></StackPanel>
                        <StackPanel><TextBlock Text="色条高度 DIP（6～24）"/><TextBox Text="{Binding BarHeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="色条高度"/></StackPanel>
                        <StackPanel><TextBlock Text="日程高度占比 %（10～100，贴上沿）"/><TextBox Text="{Binding ScheduleHeightPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="日程色带高度占比"/></StackPanel>
                        <StackPanel><TextBlock Text="底部间距 DIP（0～80）"/><TextBox Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="底部间距"/></StackPanel>
                        <StackPanel><TextBlock Text="不透明度（0.2～1）"/><TextBox Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="不透明度"/></StackPanel>
                        <StackPanel><TextBlock Text="白昼颜色（#RRGGBB）"/><TextBox Text="{Binding DayColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="白昼颜色"/></StackPanel>
                        <StackPanel><TextBlock Text="夜间颜色（#RRGGBB）"/><TextBox Text="{Binding NightColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="夜间颜色"/></StackPanel>
                        <StackPanel><TextBlock Text="日出日落过渡半宽（5～120 分钟）"/><TextBox Text="{Binding Transition, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="过渡分钟数"/></StackPanel>
                    </UniformGrid>
                    <CheckBox Content="在悬浮条下方显示小时刻度（默认关闭）" IsChecked="{Binding ShowHourTicks}"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="当前时间指针">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="指针样式"/><ComboBox ItemsSource="{Binding Indicators}" SelectedIndex="{Binding IndicatorIndex}" AutomationProperties.Name="指针样式"/>
                    <StackPanel IsEnabled="{Binding IsEmoji}"><TextBlock Text="Emoji / 单个符号"/><TextBox Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="指针 Emoji"/></StackPanel>
                    <StackPanel IsEnabled="{Binding IsPng}">
                        <TextBlock Text="PNG 图片（最多 5 MB）"/><TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PNG 图片路径"/>
                        <Button Content="选择 PNG…" Click="OnChoosePng" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Text="保存时将新图片复制到应用数据目录，原文件移走后仍可使用。图片不可用时安全回退到圆点。" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#52627A"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="每日固定标记">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="每天重复的时间分割点。04:00 之前的时刻归入次日，例如 00:30。" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                        <Button Content="添加标记" Click="OnAddMarker"/><Button Content="删除选中标记" Click="OnRemoveMarker"/>
                        <Button Content="清除全部标记" Click="OnClearMarkers" IsEnabled="{Binding CanClearMarkers}"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="常用预设：" VerticalAlignment="Center"/>
                        <Button Content="上班 10:00" Tag="0" Click="OnAddPreset"/>
                        <Button Content="午饭 12:00" Tag="1" Click="OnAddPreset"/>
                        <Button Content="晚饭 18:00" Tag="2" Click="OnAddPreset"/>
                        <Button Content="睡觉 23:00" Tag="3" Click="OnAddPreset"/>
                    </WrapPanel>
                    <DataGrid x:Name="MarkersGrid" Grid.Row="3" ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="标签" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="120"/>
                            <DataGridTemplateColumn Header="时间（时 : 分）" Width="145">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="3,0">
                                        <ComboBox Width="56" Margin="0,3" Padding="2" IsEditable="True" ItemsSource="{x:Static vm:MarkerRow.Hours}" Text="{Binding Hour, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="标记小时"/>
                                        <TextBlock Text=":" Margin="3,0" VerticalAlignment="Center"/>
                                        <ComboBox Width="56" Margin="0,3" Padding="2" IsEditable="True" ItemsSource="{x:Static vm:MarkerRow.Minutes}" Text="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="标记分钟"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="颜色" Width="220">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="144" Margin="3" Padding="2" ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding Color, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="标记预设颜色">
                                            <ComboBox.ItemTemplate><DataTemplate>
                                                <StackPanel Orientation="Horizontal"><Border Width="20" Height="16" Margin="1,0,7,0" Background="{Binding}" BorderBrush="#82909F" BorderThickness="1"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel>
                                            </DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="调色…" Padding="7,3" Margin="2" Click="OnChooseMarkerColor"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="运行">
                <StackPanel Margin="20">
                    <CheckBox Content="登录 Windows 后自动启动 Sunny Bar（仅当前用户）" IsChecked="{Binding StartWithWindows}"/>
                    <TextBlock Text="默认关闭。移动应用目录后，请重新保存此设置。开发版登录启动时可能短暂闪过命令窗口。" TextWrapping="Wrap" Margin="0,12,0,20" Foreground="#52627A"/>
                    <TextBlock Text="关闭设置或预览窗口后，时间条继续运行。隐藏、显示和退出通过系统托盘太阳图标管理。" TextWrapping="Wrap"/>
                    <Expander Header="本地配置位置" Margin="0,20,0,0"><TextBlock Text="{Binding SettingsPath}" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
                    <TextBlock Text="{Binding VersionText}" Foreground="#52627A" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <ScrollViewer Grid.Row="2" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,12,0,4">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#884A0B" AutomationProperties.Name="保存状态"/>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ManageSchedulesButton" Content="管理日程…" Click="OnSchedule"/>
            <Button Content="查看当前预览" Click="OnPreview"/>
            <Button Content="保存并应用" Click="OnSave" IsEnabled="{Binding CanSave}" IsDefault="True"/>
            <Button Content="关闭" Click="OnClose" IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
