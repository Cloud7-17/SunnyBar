<Window x:Class="SunnyBar.App.Views.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SunnyBar.App.Controls"
        Title="Sunny Bar — 悬浮时间轴" Width="800" Height="32" Left="0" Top="0"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Opacity="{Binding Settings.Appearance.Opacity}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <controls:TimelineControl Snapshot="{Binding Snapshot}" IndicatorImage="{Binding IndicatorImage}" IsCompact="True" IsHitTestVisible="False" />
</Window>
